# Server-only connection required by runtime /api/products and /api/demo/home.
# Pull the Development value from the existing Vercel project with vercel env pull.
# No NEXT_PUBLIC_* variable is required. Never commit the real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Offline recommendation index (local, not under public/).
RECOMMENDATION_DATA_DIR=.recommendation
# behavior | metadata; UI uses this default, API callers may pass mode explicitly.
RECOMMENDATION_MODE=behavior
# Miniroom: server-to-server product ID lookup in the deployed asset service.
# The product database remains separate. No NEXT_PUBLIC_* secret is needed.
ASSET_API_URL=https://ASSET-SERVICE.example

# Asset service / importer only. Optional when using ASSET_API_URL above.
# Use the separate asset database, never the product database.
# ASSET_DATABASE_URL=postgresql://USER:PASSWORD@HOST/gscene_assets?sslmode=require
# ASSET_BASE_URL=https://STORE.public.blob.vercel-storage.com
