{
  "name": "gscene-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "node app/tests/movement.test.mjs && node app/tests/input.test.mjs && node app/tests/interactions.test.mjs && node app/tests/object-art.test.mjs && node --test tests/api.test.mjs && node app/tests/home-food.test.mjs && node --test tests/food.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
